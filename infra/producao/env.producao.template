# Molde do .env de produção. Gerado no servidor por scripts/producao-init-env.sh (@GERAR_*@ viram valores aleatórios).
APP_NAME=Gabaritu
APP_ENV=production
APP_DEBUG=false
APP_KEY=@GERAR_APP_KEY@
APP_URL=https://gabaritu.gorilash.com.br
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

# Atrás do nginx de borda (faixa dos bridges do Docker).
TRUSTED_PROXIES=172.16.0.0/12

# Modo "em breve": só a página de contato. Não abrir antes da revisão de segurança.
GABARITU_CADASTRO_ABERTO=false
GABARITU_EMAIL_CONTATO=gabaritu@gorilash.com.br

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=gabaritu
DB_USERNAME=gabaritu
DB_PASSWORD=@GERAR_DB_PASSWORD@

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Com o cadastro fechado nada envia e-mail; o serviço transacional ainda não foi escolhido.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="gabaritu@gorilash.com.br"
MAIL_FROM_NAME="${APP_NAME}"

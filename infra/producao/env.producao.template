# Molde do .env de produção. Gerado no servidor por scripts/producao-init-env.sh (@GERAR_*@ viram valores aleatórios).
APP_NAME=Gabaritu
APP_ENV=production
APP_DEBUG=false
APP_KEY=@GERAR_APP_KEY@
APP_URL=https://gabaritu.gorilash.com.br
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

# Atrás do nginx de borda (faixa dos bridges do Docker).
TRUSTED_PROXIES=172.16.0.0/12

# Modo "em breve": só a página de contato. Não abrir antes da revisão de segurança.
GABARITU_CADASTRO_ABERTO=false
GABARITU_EMAIL_CONTATO=gabaritu@gorilash.com.br
# Piloto: questões do ENEM (INEP) visíveis para o aluno. Voltar a false esconde tudo sem apagar nada.
GABARITU_EXIBIR_INEP=true
# Prefixo das rotas do painel admin (docs/admin.md), sem barras. Produção usa "admin" (decisão do dono).
GABARITU_ADMIN_PREFIXO=admin
# Saúde do sistema no painel: GABARITU_VERSAO é gravada pelo deploy-producao.sh a cada deploy e
# GABARITU_BACKUP_DIR é fixada no compose (/backup-status). Não preencha à mão.

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=gabaritu
DB_USERNAME=gabaritu
DB_PASSWORD=@GERAR_DB_PASSWORD@

SESSION_DRIVER=database
# Sessão cifrada na tabela `sessions` (defesa em profundidade; quem vê o banco não lê o conteúdo da sessão).
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# E-mail transacional por SMTP. Preencha os @PLACEHOLDERS@ no servidor; nunca versione credenciais.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=@SMTP_HOST@
MAIL_PORT=465
MAIL_USERNAME=@SMTP_USUARIO@
MAIL_PASSWORD=@SMTP_SENHA@
MAIL_FROM_ADDRESS="gabaritu@gorilash.com.br"
MAIL_FROM_NAME="${APP_NAME}"

        "etiqueta": "ing-sentido-errado"
      },
      {
        "letra": "C",
        "texto": "fazem o primeiro saque no tênis.",
        "correta": false,
        "etiqueta": "ing-sentido-errado"
      },
      {
        "letra": "D",
        "texto": "oferecem, vendem (comida).",

        "etiqueta": "ing-extrapolou"
      }
    ],
    "explicacao": "Em um restaurante, \"serve\" quer dizer colocar comida à disposição dos clientes. Os outros sentidos não combinam com \"burgers\".",
    "fala_especifica": null,
    "fonte": "autoral-ia",
    "licenca": "CC-BY-SA-4.0"
  },

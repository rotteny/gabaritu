    "materia": "ingles",
    "assunto": "gramatica-em-contexto",
    "questionario": 1,
    "dificuldade": -1,
    "contexto": "Pizza e macarrão",
    "enunciado": "\"Ana likes pizza, but she doesn't like pasta.\"\n\nNessa frase, o conector \"but\" indica",
    "alternativas": [
      {
        "letra": "A",
        "texto": "contraste entre duas ideias.",
        "correta": true,
        "etiqueta": null
      },
      {
        "letra": "B",
        "texto": "causa da ideia anterior.",
        "correta": false,
        "etiqueta": "ing-conector-errado"
      },
      {
        "letra": "C",
        "texto": "consequência da ideia anterior.",
        "correta": false,
        "etiqueta": "ing-conector-errado"
      },
      {
        "letra": "D",
        "texto": "soma de duas ideias iguais.",
        "correta": false,
        "etiqueta": "ing-conector-errado"
      },
      {
        "letra": "E",
        "texto": "condição para a segunda ideia.",
        "correta": false,
        "etiqueta": "ing-conector-errado"
      }
    ],
    "explicacao": "\"But\" equivale a \"mas\". Ana gosta de uma coisa e não gosta de outra, então há oposição.",
    "fala_especifica": null,
    "fonte": "autoral-ia",
    "licenca": "CC-BY-SA-4.0"
  },

      },
      {
        "letra": "C",
        "texto": "uma causa: o trabalho durante a noite.",
        "correta": true,
        "etiqueta": null
      },
      {
        "letra": "D",
        "texto": "uma alternativa: ou trabalhou.",
        "correta": false,
        "etiqueta": "ing-conector-errado"
